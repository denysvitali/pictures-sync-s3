@@ -181,7 +275,13 @@ func run() error {
 	if err := chown("modules_out"); err != nil {
 		return err
 	}
-	if err := os.Rename(filepath.Join(kernelFolder, "modules_out", "lib"), filepath.Join(dstFolder, "lib")); err != nil {
+	if err := os.MkdirAll(filepath.Join(dstFolder, "lib", "modules"), 0755); err != nil {
+		return err
+	}
+	if err := os.Rename(filepath.Join(kernelFolder, "modules_out", "lib", "modules", release), filepath.Join(dstFolder, "lib", "modules", release)); err != nil {
+		return err
