+		"--enable", "NLS_UTF8",
+
 		// WiFi
 		"--enable", "RFKILL",
 		"--enable", "CFG80211",
@@ -141,12 +165,80 @@ func run() error {
 		"--module", "USB_SERIAL_SAFE",
 	}
 
+	required := []string{}
+	if *pi4Flag {
+		args = append(args,
+			// BCM2711 maps PCIe (and with it the VL805 USB controller)
+			// above 4 GiB, which a 32-bit kernel only reaches with LPAE.
+			"--enable", "ARM_LPAE",
+			"--enable", "HIGHMEM",
