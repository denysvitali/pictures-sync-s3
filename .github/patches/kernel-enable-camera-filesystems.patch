 var kernelFolderFlag = flag.String("kernel", "./linux-sources", "folder containing the kernel to compile")
 
+// The Raspberry Pi 4 (Cortex-A72) cannot execute the ARMv6-only bcmrpi kernel,
+// so the image carries a second ARMv7 LPAE kernel next to it. Both share the
+// ARMv6 userspace; config.txt selects the kernel per board.
+var pi4Flag = flag.Bool("pi4", false, "build the ARMv7 Raspberry Pi 4 kernel as dist/vmlinuz.v7 and add it to an existing dist folder")
+
 func run() error {
 	flag.Parse()
 
@@ -61,7 +66,15 @@ func run() error {
 
 	// bcmrpi_defconfig: default raspberry pi config according to https://www.raspberrypi.com/documentation/computers/linux_kernel.html#cross-compiling-the-kernel
 	// mod2noconfig: disable all modules
-	if err := dockerRun("make", "bcmrpi_defconfig", "mod2noconfig"); err != nil {
+	defconfig, image := "bcmrpi_defconfig", "vmlinuz"
+	if *pi4Flag {
+		defconfig, image = "bcm2709_defconfig", "vmlinuz.v7"
+		// Drop the ARMv6 objects left behind by the previous build.
+		if err := dockerRun("make", "clean"); err != nil {
+			return err
+		}
+	}
+	if err := dockerRun("make", defconfig, "mod2noconfig"); err != nil {
 		return err
 	}
 
@@ -80,6 +93,17 @@ func run() error {
 		"--disable", "MODULE_COMPRESS_XZ",
 		"--disable", "MODULE_COMPRESS_ZSTD",
 
+		// Camera SD card filesystems. Keep these built in: gokrazy does not
+		// provide a general-purpose module loader during early appliance use.
+		"--enable", "FAT_FS",
+		"--enable", "MSDOS_FS",
+		"--enable", "VFAT_FS",
