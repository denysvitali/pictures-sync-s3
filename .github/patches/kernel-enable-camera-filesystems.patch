+			"--enable", "MMC_SDHCI_PLTFM",
+			"--enable", "MMC_SDHCI_IPROC",
+			"--enable", "REGULATOR",
+			"--enable", "REGULATOR_FIXED_VOLTAGE",
+			"--enable", "REGULATOR_GPIO",
+			"--enable", "GPIO_RASPBERRYPI_EXP",
+
+			// Ethernet
+			"--enable", "BCMGENET",
+			"--enable", "BROADCOM_PHY",
+
+			// USB (SD card reader) behind PCIe
+			"--enable", "PCI",
+			"--enable", "PCI_MSI",
+			"--enable", "PCIE_BRCMSTB",
+			"--enable", "USB_XHCI_HCD",
+			"--enable", "USB_XHCI_PCI",
+			"--enable", "RESET_RASPBERRYPI",
+
+			// Onboard Wi-Fi power sequencing
+			"--enable", "PWRSEQ_SIMPLE",
+		)
+		required = append(required,
+			"CONFIG_ARM_LPAE=y",
+			"CONFIG_KUSER_HELPERS=y",
+			"CONFIG_VFP=y",
+			"CONFIG_SQUASHFS=y",
+			"CONFIG_MMC_SDHCI_IPROC=y",
+			"CONFIG_MMC_BCM2835_MMC=y",
+			"CONFIG_REGULATOR_FIXED_VOLTAGE=y",
+			"CONFIG_REGULATOR_GPIO=y",
+			"CONFIG_GPIO_RASPBERRYPI_EXP=y",
+			"CONFIG_BCMGENET=y",
+			"CONFIG_PCIE_BRCMSTB=y",
+			"CONFIG_USB_XHCI_PCI=y",
+			"CONFIG_RESET_RASPBERRYPI=y",
+			"CONFIG_USB_STORAGE=y",
+			"CONFIG_PWRSEQ_SIMPLE=y",
+			"CONFIG_CFG80211=y",
+			"CONFIG_BRCMFMAC=m",
+			"CONFIG_BRCMFMAC_SDIO=y",
+		)
+	}
+
 	if err := dockerRun(args...); err != nil {
 		return err
 	}
 	if err := dockerRun("make", "olddefconfig"); err != nil {
 		return err
 	}
+	for _, option := range append(required,
+		"CONFIG_FAT_FS=y",
+		"CONFIG_MSDOS_FS=y",
+		"CONFIG_VFAT_FS=y",
+		"CONFIG_EXFAT_FS=y",
+		"CONFIG_NLS_CODEPAGE_437=y",
+		"CONFIG_NLS_UTF8=y",
+	) {
+		if err := dockerRun("grep", "-qx", option, ".config"); err != nil {
+			return fmt.Errorf("required kernel option %s is not enabled: %w", option, err)
+		}
+	}
 
 	// compile kernel and dtbs
 	if err := dockerRun("make", "zImage", "dtbs", "modules", "-j"+strconv.Itoa(runtime.NumCPU())); err != nil {
@@ -164,13 +256,15 @@ func run() error {
 
 	bootFolder := filepath.Join(kernelFolder, "arch", "arm", "boot")
 	dstFolder := filepath.Join(".", "dist")
